rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict user-ownership model for personal data and reports, 
     * while providing read-only access to global epidemiological data for all authenticated 
     * users (including anonymous guests).
     *
     * DATA STRUCTURE:
     * 1. /userProfiles/{userId}: Private root for user metadata.
     * 2. /outbreaks/{outbreakId}: Global read-only disease cluster data.
     * 3. /systemOutbreakReports/{reportId}: Global read-only analytical reports.
     * 4. /userProfiles/{userId}/outbreakReports/{reportId}: Private user-specific reports.
     *
     * KEY SECURITY DECISIONS:
     * - Authentication: Required for all operations. Anonymous and Email/Password users are treated as authorized.
     * - Ownership: Path-based authorization is used for all user-specific collections.
     * - Relational Integrity: On creation of user-scoped data, the document must contain a field (id or userId) 
     *   matching the UID in the path to ensure data consistency.
     * - Denormalization for Authorization: User IDs are denormalized into sub-documents (e.g., OutbreakReport) 
     *   to allow for atomic, path-independent security checks if needed, though path-based checks are prioritized.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from a signed-in user (Email or Anonymous). */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is the owner and the document exists (for update/delete). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for individual user profile metadata.
     * @path /userProfiles/{userId}
     * @allow (get) request.auth.uid == 'user_123' and path is /userProfiles/user_123
     * @deny (list) Attempting to list all user profiles.
     * @principle Restricts access to a user's own profile tree and validates path consistency.
     */
    match /userProfiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users; typically profiles are fetched by ID.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Reports generated by and belonging to a specific user.
       * @path /userProfiles/{userId}/outbreakReports/{reportId}
       * @allow (create) Authenticated user creating a report in their own subcollection.
       * @deny (update) User trying to change the 'userId' field of an existing report.
       * @principle Path-based ownership with immutable relational field enforcement.
       */
      match /outbreakReports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Global disease outbreak data used for heatmaps.
     * @path /outbreaks/{outbreakId}
     * @allow (list) Any authenticated user viewing the map.
     * @deny (create) Any user attempting to manually insert outbreak data.
     * @principle Read-only access for authenticated users; system-managed data.
     */
    match /outbreaks/{outbreakId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description System-generated global reports available to all users.
     * @path /systemOutbreakReports/{reportId}
     * @allow (get) Any authenticated user reading a public report.
     * @deny (delete) A user attempting to delete a system report.
     * @principle Read-only access for authenticated users; system-managed data.
     */
    match /systemOutbreakReports/{reportId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}